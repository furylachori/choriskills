#!/usr/bin/env bash
# Run all offline unit tests for the entire claw-skills repository.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

echo "=========================================="
echo "  Testing all claw-skills"
echo "=========================================="
echo ""

PYTHONPATH="bailian-qwen-image:bailian-wan-image:minimax-video:stepfun-tts:stepfun-asr:stepfun-image" python3 -m pytest \
  tests/ \
  bailian-qwen-image/tests/ \
  bailian-wan-image/tests/ \
  -v -m "not integration"

echo ""
echo "=========================================="
echo "  All tests passed!"
echo "=========================================="
